{
  "enabledPlugins": {
    "watson@watson": true
  },
  "model": "haiku",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Skill",
      "Agent"
    ],
    "deny": [
      "Bash(git:*)",
      "Edit(/indice/**)",
      "Write(/indice/**)",
      "Edit(/diario-di-bordo/**)",
      "Write(/diario-di-bordo/**)",
      "Edit(/.claude/**)",
      "Write(/.claude/**)",
      "WebFetch",
      "WebSearch"
    ]
  },
  "env": {
    "CLAUDE_CODE_DISABLE_BACKGROUND_TASKS": "1"
  }
}
